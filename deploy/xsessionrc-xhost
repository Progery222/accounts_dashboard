# Дать локальным клиентам доступ к экрану RDP-сессии.
#
# Окно входа в площадки («Войти» в настройках) открывает контейнер dashboard,
# он работает от root. Контроль доступа X пускает на экран только владельца
# сессии, поэтому без этой строки окно нарисовать негде и войти руками нельзя.
#
# Ограничение local: наружу ничего не открывает — доступ только через сокет
# на самой машине.
#
# Установка на сервере (один раз, от пользователя сессии):
#   cp deploy/xsessionrc-xhost ~/.xsessionrc
# Срабатывает при каждом новом подключении по RDP: /etc/X11/Xsession
# подхватывает ~/.xsessionrc.
if command -v xhost >/dev/null 2>&1; then
    xhost +local: >/dev/null 2>&1 || true
fi