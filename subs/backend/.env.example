DEBUG=True
SECRET_KEY=change-me-subs-only
ALLOWED_HOSTS=localhost,127.0.0.1
# Для trycloudflare / loca.lt суффиксы .trycloudflare.com и .loca.lt добавляются в settings автоматически.

# Postgres (Docker: ../docker-compose.yml, порт хоста 5435):
# DATABASE_URL=postgresql://subs:subs@127.0.0.1:5435/subs
# Без Docker: оставьте пустым — будет SQLite (файл subs.sqlite3 рядом с manage.py).
DATABASE_URL=

# API дашборда (синхронизация, съём аудитории, авторизация в iframe на фронте)
DASHBOARD_API_URL=http://127.0.0.1:8000

# Origin фронта subs (Vite, порт 5180). Регексы trycloudflare/loca.lt добавлены в settings.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
