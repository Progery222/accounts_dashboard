# URL subs API.
# Для `npm run dev` / trycloudflare: оставьте пустым — запросы идут на тот же HTTPS-origin (/api…), Vite проксирует на :8000.
# Не задавайте http://127.0.0.1:8000 при открытии SPA по https://*.trycloudflare.com — браузер заблокирует mixed content («Failed to fetch»).
# Явный URL — только если API на другом публичном HTTPS-хосте:
# VITE_API_URL=https://subs-api.example.com
VITE_API_URL=
# База основного API дашборда (синхронизация и т.д.). Тот же URL по умолчанию использует Vite-прокси /api → Django.
VITE_DASHBOARD_API_URL=http://127.0.0.1:8000
# Явно переопределить цель прокси (если Django не на 127.0.0.1:8000: WSL, Docker, другой порт):
# SUBS_DEV_PROXY_TARGET=http://172.28.80.1:8000
SUBS_DEV_PROXY_TARGET=
VITE_DASHBOARD_APP_URL=http://localhost:5174
