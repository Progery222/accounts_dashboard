{
  "name": "subs-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "tunnel": "cloudflared tunnel --config cloudflared.5180.yml --url http://127.0.0.1:5180",
    "tunnel:5180": "cloudflared tunnel --config cloudflared.5180.yml --url http://127.0.0.1:5180",
    "tunnel:login": "cloudflared tunnel login",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5180"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
