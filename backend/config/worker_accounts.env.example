# Скопируйте в worker_accounts.env (рядом с этим файлом) — профиль Chromium и headless
# для всех Playwright-воркеров: обновление аккаунтов, refresh_all, съём аудитории
# (и с дашборда, и по запросу из приложения «Подписчики» на тот же API).

# Явный каталог профиля (cookies / storage state). Пусто — как раньше: BROWSER_PROFILE_DIR из основного .env или дефолт из platforms/worker_utils.py
# ACCOUNTS_BROWSER_PROFILE_DIR=C:\path\to\TikStatsChromeProfile

# Headless только для этого пула (перекрывает BROWSER_HEADLESS из основного .env при задании).
# Не задавайте или false — видимые окна Chrome (как при локальной отладке).
# ACCOUNTS_BROWSER_HEADLESS=false

# Автообновление по расписанию: true = сразу поднять Playwright по каждой платформе в батче (много окон).
# По умолчанию в коде — false: окно платформы откроется при первом обращении к ней (одно на платформу).
# ACCOUNTS_AUTOREFRESH_PREWARM_PLAYWRIGHT=true

# Параллельных потоков в автообновлении и «Обновить всё» (по умолчанию 6).
# AUTO_REFRESH_WORKERS=6

# Ночные слоты 00:00 и 06:00: если первый прогон ещё идёт, второй ставится в очередь (до 3 подряд).
# AUTO_REFRESH_MAX_QUEUED=3
# Пауза между подряд идущими прогонами из очереди (сек), по умолчанию 600 (10 мин).
# AUTO_REFRESH_MIN_GAP_SEC=600
# Сброс «зависшего» is_running: прогон > 14 ч или нет прогресса > 4 ч (см. apps.py).
# AUTO_REFRESH_STALE_HOURS=14
# AUTO_REFRESH_STALL_HOURS=4

# Threads: таймаут открытия профиля в Playwright (мс), по умолчанию 60000
# THREADS_NAV_TIMEOUT_MS=60000
# Пауза между аккаунтами Threads в автообновлении / refresh_all (сек, джиттер)
# REFRESH_ALL_DELAY_THREADS_MIN=2
# REFRESH_ALL_DELAY_THREADS_MAX=4
# TikTok: пауза между аккаунтами (сек, джиттер). По умолчанию в коде 50–200.
# REFRESH_ALL_DELAY_TIKTOK_MIN=50
# REFRESH_ALL_DELAY_TIKTOK_MAX=200
# Вход через «Настройки → TikTok»: по умолчанию только ручной ввод (не подставлять логин/пароль из .env).
# TIKTOK_AUTH_AUTOFILL=false
# Facebook: пауза между аккаунтами (сек, джиттер). По умолчанию в коде 180–360 (3–6 мин).
# REFRESH_ALL_DELAY_FACEBOOK_MIN=180
# REFRESH_ALL_DELAY_FACEBOOK_MAX=360

# Таймаут page.goto при входе в настройках (все платформы), мс, по умолчанию 45000
# AUTH_NAV_TIMEOUT_MS=45000

# Facebook: параметры браузера (UI «Параметры браузера» или config/facebook_browser_profile.json)
# FACEBOOK_LOCALE=ru-RU
# FACEBOOK_LANGUAGES=ru-RU,ru,en-US,en
# FACEBOOK_VIEWPORT_WIDTH=1366
# FACEBOOK_VIEWPORT_HEIGHT=900
# FACEBOOK_USER_AGENT=Mozilla/5.0 ...
# FACEBOOK_STEALTH_ENABLED=true
# FACEBOOK_HIDE_AUTOMATION_FLAGS=true
# Прогрев warm_facebook_session: URL ленты Reels (по умолчанию https://www.facebook.com/reel/)
# FACEBOOK_WARM_REELS_URL=https://www.facebook.com/reel/
