SECRET_KEY=changeme-generate-a-real-secret
DEBUG=false
# IP / домен(ы) через запятую. Пример для VPS:
#   ALLOWED_HOSTS=146.103.120.54,dashboard.example.com,localhost
ALLOWED_HOSTS=yourdomain.com,localhost

# Локально: cloudflared trycloudflare / ngrok шлют на http://127.0.0.1:8000 с
# X-Forwarded-Proto: https. При DEBUG=false без этого Django не считает запрос
# безопасным и режет CSRF (POST /api/… → 403). На Railway не задавайте.
DJANGO_USE_TLS_PROXY_HEADERS=1

# Origin'ы (схема + хост + порт) для CSRF, через запятую. Нужны Django, чтобы
# принимать POST/PUT/DELETE с публичного фронта. Пример для VPS варианта A:
#   CSRF_EXTRA_ORIGINS=http://146.103.120.54:8080
# Для CORS используется CORS_EXTRA_ORIGINS аналогично:
#   CORS_EXTRA_ORIGINS=http://146.103.120.54:8080
CSRF_EXTRA_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
CORS_EXTRA_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Синхронизация «Подписчиков» (subs) ходит на основной API дашборда по HTTP (по умолчанию :8000).
# Меняйте только если дашборд на другом origin: DASHBOARD_API_URL=https://api.example.com
# DASHBOARD_API_URL=http://127.0.0.1:8000

# Links (клики по коротким ссылкам из bio) — обновляются при refresh аккаунта
# LINKS_API_URL=https://your-links-service.up.railway.app
# LINKS_API_TOKEN=
# LINKS_API_TIMEOUT=25

# Playwright-воркеры: backend/config/worker_accounts.env — профиль браузера для дашборда и съёма аудитории (в т.ч. из Subs).
# worker_subs.env — отдельный файл только для настроек приложения «Подписчики», не для сессий браузера (см. *.env.example).

# Railway (backend-сервис): публичный хост фронтенда без схемы или с https://
# (второй сервис в том же проекте). Альтернатива — заполнить CSRF_EXTRA_ORIGINS
# и CORS_EXTRA_ORIGINS вручную тем же origin'ом.
#   RAILWAY_FRONTEND_PUBLIC_DOMAIN=xxx-production.up.railway.app
RAILWAY_FRONTEND_PUBLIC_DOMAIN=

# Postgres по DATABASE_URL: на Railway по умолчанию ssl_require=true.
# Локальный URL без SSL — DB_SSL_REQUIRE=false
DB_SSL_REQUIRE=

# Пул соединений (секунды). После рестарта Postgres Django переподключается, если
# CONN_HEALTH_CHECKS включён в settings (включено для postgresql/postgis).
DB_CONN_MAX_AGE=600
DB_CONNECT_TIMEOUT=10

DB_NAME=dashboard
DB_USER=dashboard
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Пример Postgres в одну строку (Railway задаёт автоматически):
# DATABASE_URL=postgresql://dashboard:changeme@localhost:5432/dashboard
# DB_SSL_REQUIRE=false

# Scheduler: на проде с несколькими gunicorn-воркерами включайте scheduler ТОЛЬКО
# в отдельном контейнере/процессе (см. docker-compose.yml + manage.py run_scheduler).
# В веб-контейнере: RUN_SCHEDULER=false.
RUN_SCHEDULER=true

# YouTube Data API v3 (console.cloud.google.com → YouTube Data API v3 → API key)
YOUTUBE_API_KEY=

# ── Browser / TikTok ─────────────────────────────────────────────────────────
# Сервер: true | Локальная разработка: false
BROWSER_HEADLESS=true
# Локально: куда сохранить куки после `python manage.py setup_tiktok_auth`
# (команда требует непустой путь). В Docker/Railway воркер TikTok при обычном
# запуске читает только <BROWSER_PROFILE_DIR>/tiktok_state.json (см.
# backend/Dockerfile ENV BROWSER_PROFILE_DIR=/app/.browser-profile) — файл
# нужно положить на volume именно там; переменную BROWSER_STATE_FILE в проде
# можно не задавать.
BROWSER_STATE_FILE=tiktok_state.json
BROWSER_PROFILE_DIR=
# Логин/пароль в .env не обязательны; при входе через UI по умолчанию — ручной ввод в браузере.
# TIKTOK_USERNAME=your_tiktok_login
# TIKTOK_PASSWORD=your_tiktok_password
# Автовставка при /api/settings/tiktok/start-auth/ (по умолчанию выкл.).
TIKTOK_AUTH_AUTOFILL=false
# TIKTOK_AUTH_AUTOFILL=true
# true — каждый refresh TikTok через Playwright (окно); false — HTTP-first, worker только при неполном SSR.
# TIKTOK_FORCE_WORKER=false

# Per-platform overrides (true/false) — оставьте пустым, чтобы использовать
# глобальный BROWSER_HEADLESS. Пример: TELEGRAM_HEADLESS=false под Xvfb.
# TELEGRAM_HEADLESS=
# FACEBOOK_HEADLESS=
# TIKTOK_HEADLESS=
# RUMBLE_HEADLESS=
# THREADS_HEADLESS=
# X_HEADLESS=
# INSTAGRAM_HEADLESS=

# Если по-прежнему нужен системный Google Chrome (старое поведение):
# RUMBLE_BROWSER_CHANNEL=chrome
# TIKTOK_BROWSER_CHANNEL=chrome

# ── Instagram ────────────────────────────────────────────────────────────────
INSTAGRAM_USERNAME=your_ig_login
INSTAGRAM_PASSWORD=your_ig_password
INSTAGRAM_SESSION_FILE=/app/instagram.session

# ── Telegram ─────────────────────────────────────────────────────────────────
# my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Авторизоваться командой: python manage.py setup_telegram_auth
TELEGRAM_SESSION_FILE=/app/telegram.session

# Bot API (@BotFather) — отчёт автообновления в личный чат
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTO_REFRESH_CHAT_ID=

# ── Facebook ─────────────────────────────────────────────────────────────────
# ТОЛЬКО через env. В коде settings.py — пустые значения.
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# ── Apify (альтернатива Playwright для refresh FB / TikTok / Instagram) ─────
# APIFY_ENABLED=0 — в UI и API нельзя выбрать Apify
APIFY_ENABLED=0
APIFY_TOKEN=
APIFY_ACTOR_TIKTOK=clockworks/tiktok-profile-scraper
APIFY_ACTOR_FACEBOOK_PROFILE=crowdpull/facebook-profile-scraper
APIFY_ACTOR_FACEBOOK_PLAYCOUNT=social_developer/facebook-playcount-scraper
APIFY_ACTOR_INSTAGRAM_PROFILE=apify/instagram-profile-scraper
APIFY_ACTOR_INSTAGRAM_POSTS=apify/instagram-scraper
APIFY_ACTOR_YOUTUBE=streamers/youtube-scraper
APIFY_ACTOR_REDDIT=automation-lab/reddit-scraper
APIFY_ACTOR_RUMBLE=thescrapelab/apify-rumble-scraper
APIFY_MAX_CONCURRENT_RUNS=3
APIFY_POLL_INTERVAL_SEC=15
# APIFY_POLL_MAX_WAIT_SEC=900
# APIFY_WEBHOOK_SECRET=
# APIFY_WEBHOOK_BASE_URL=https://your-dashboard.example.com

# Файловые логи (prod / Mobile Farm): backend/var/log или volume var/log/dashboard
# DASHBOARD_FILE_LOG=1
# DASHBOARD_LOG_DIR=/app/var/log
# DASHBOARD_LOG_RETENTION_DAYS=7
# DASHBOARD_LOG_LEVEL=INFO
